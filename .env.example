# HUHU'S PIZZAS — Environment variables
# Copy to .env.local and fill. Never commit .env.local.

# ── Supabase (Postgres + Auth + Realtime + Storage) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# In production, menu/orders/posts/settings live in Supabase. For local demo we fallback to /data/*.json + localStorage.

# ── M-Pesa Daraja (Safaricom) ──
MPESA_ENV=sandbox # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE= # Till or Paybill (e.g. 174379 for sandbox)
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
# Get these from https://developer.safaricom.co.ke — requires approved Till/Paybill. See README for go-live steps.

# ── Notifications ──
RESEND_API_KEY= # for email receipts (Resend)
RESEND_FROM_EMAIL=orders@huhuspizzas.co.ke
RESEND_TO_EMAIL=kitchen@huhuspizzas.co.ke
AFRICAS_TALKING_API_KEY= # optional SMS via Africa's Talking
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=HUHUS

# ── Analytics ──
NEXT_PUBLIC_GA4_ID=G-XXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://huhuspizzas.co.ke
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000
NEXT_PUBLIC_PHONE=+254700000000
